  +MaintenanceSchedules : DbSet<MaintenanceSchedule>
}
class VehicleService
class BookingService
class StaffService
class MaintenanceService #FFE0B2
class CarTypeService #C8E6C9
class MaintenanceSchedule <<entity>> #FFE0B2

IRepo <|.. Repo
Repo --> FlemanDbContext
VehicleService --> IRepo
BookingService --> IRepo
StaffService --> IRepo
MaintenanceService --> IRepo : MaintenanceSchedule, Car
CarTypeService --> IRepo : CarType
FlemanDbContext ..> MaintenanceSchedule

legend bottom
  Orange: added by Change1 (new entity and new client).
  Green: added by Change2 (new client).
