@@ -0,0 +1,42 @@
+using FlemanApi.Models;
+
+namespace FlemanApi.Service.Maintenance;
+
+// Context role of the State pattern: holds the schedule, the car it is for
+// and the current state object, and forwards every operation to that state.
+public sealed class MaintenanceContext
+{
+    private static readonly IReadOnlyDictionary<MaintenanceStatus, IMaintenanceState> States =
+        new Dictionary<MaintenanceStatus, IMaintenanceState>
+        {
+            [MaintenanceStatus.SCHEDULED] = ScheduledState.Instance,
+            [MaintenanceStatus.IN_PROGRESS] = InProgressState.Instance,
+            [MaintenanceStatus.COMPLETED] = CompletedState.Instance,
+            [MaintenanceStatus.CANCELLED] = CancelledState.Instance,
+        };
+
+    public MaintenanceSchedule Schedule { get; }
+    public Car Car { get; }
+    public DateTime Now { get; }
+    public IMaintenanceState State { get; private set; }
+
+    public MaintenanceContext(MaintenanceSchedule schedule, Car car, DateTime now)
+    {
+        Schedule = schedule;
+        Car = car;
+        Now = now;
+        State = States[schedule.Status];
+    }
+
+    public void Start() => State.Start(this);
+    public void Complete() => State.Complete(this);
+    public void Cancel() => State.Cancel(this);
+
+    // Called by the states only: keeps the state object and the persisted
+    // Schedule.Status in step.
+    public void TransitionTo(IMaintenanceState next)
+    {
+        State = next;
+        Schedule.Status = next.Status;
+    }
+}
diff --git a/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/MaintenanceStateBase.cs b/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/MaintenanceStateBase.cs
new file mode 100644
index 0000000..03a6580
--- /dev/null
+++ b/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/MaintenanceStateBase.cs
@@ -0,0 +1,26 @@
+using System.Net;
+using FlemanApi.Exceptions;
+using FlemanApi.Models;
+
+namespace FlemanApi.Service.Maintenance;
+
+// Default behaviour: every operation is illegal (409) until a concrete
+// state overrides it, so a state only lists the transitions it allows.
+public abstract class MaintenanceStateBase : IMaintenanceState
+{
+    public abstract MaintenanceStatus Status { get; }
+
+    public virtual void Start(MaintenanceContext context) => throw Illegal("start");
+    public virtual void Complete(MaintenanceContext context) => throw Illegal("complete");
+    public virtual void Cancel(MaintenanceContext context) => throw Illegal("cancel");
+
+    protected ApiException Illegal(string operation) =>
+        new($"Cannot {operation} maintenance that is {Status}", HttpStatusCode.Conflict);
+
+    // Shared by the two transitions that hand the car back to the fleet.
+    protected static void ReleaseCar(MaintenanceContext context)
+    {
+        context.Car.Status = CarStatus.AVAILABLE;
+        context.Car.IsAvailable = true;
+    }
+}
diff --git a/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/ScheduledState.cs b/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/ScheduledState.cs
new file mode 100644
index 0000000..fba5e59
--- /dev/null
+++ b/WanderCar_DotNet/src/FlemanApi/Service/Maintenance/ScheduledState.cs
@@ -0,0 +1,34 @@
+using System.Net;
+using FlemanApi.Exceptions;
+using FlemanApi.Models;
+
+namespace FlemanApi.Service.Maintenance;
+
+public sealed class ScheduledState : MaintenanceStateBase
+{
+    public static readonly ScheduledState Instance = new();
+
+    private ScheduledState() { }
+
+    public override MaintenanceStatus Status => MaintenanceStatus.SCHEDULED;
+
+    // Work can only begin on a car that is physically free right now.
+    public override void Start(MaintenanceContext context)
+    {
+        if (context.Car.Status != CarStatus.AVAILABLE)
+        {
+            throw new ApiException(
+                $"Cannot start maintenance: car {context.Car.CarId} is not available",
+                HttpStatusCode.Conflict);
+        }
+
+        context.Car.Status = CarStatus.UNDER_MAINTENANCE;
+        context.Car.IsAvailable = false;
+        context.Schedule.StartedAt = context.Now;
+        context.TransitionTo(InProgressState.Instance);
+    }
+
+    // Nothing was done to the car yet, so it is left alone.
+    public override void Cancel(MaintenanceContext context) =>
+        context.TransitionTo(CancelledState.Instance);
+}
