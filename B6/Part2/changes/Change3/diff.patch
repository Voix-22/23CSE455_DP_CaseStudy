+    private static int DaysBetween(DateTime pickup, DateTime returnDt)
+    {
+        var hours = (returnDt - pickup).TotalHours;
+        var fullDays = (long)Math.Ceiling(hours / 24.0);
+        return (int)Math.Max(1, fullDays);
+    }
