+
+        var pickup = new DateTime(2026, 10, 9);
+        var returnDate = new DateTime(2026, 10, 12);
+
+        var actual = selector.SelectPolicy(
+            MakeCarType(), pickup, returnDate);
+
+        actual.Name.Should().Be("Weekend");
+    }
